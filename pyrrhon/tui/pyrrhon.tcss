/* All layout and styling for the Textual channel (D6).
 *
 * Every colour is a token from theme.py, or one of Textual's own theme
 * variables. A hex value in this file, or in any widget module, is a bug:
 * `grep -rn "#[0-9a-fA-F]\{6\}" pyrrhon/tui/` must match theme.py alone.
 *
 * $background, $surface and $panel are Textual's, so they follow whichever
 * theme is active. $evidence, $voice, $hedge, $fault and $muted are ours, and
 * PyrrhonApp.get_theme_variable_defaults() supplies them under every theme —
 * without that, switching theme from the command palette left them undefined
 * and the stylesheet failed to parse.
 */

Screen {
    background: $background;
}

/* -- the transcript and its rows ---------------------------------------- */

#transcript {
    height: 1fr;
    padding: 0 1;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $muted;
    scrollbar-color-active: $voice;
}

#splash {
    height: auto;
    width: 1fr;
    padding: 1 0;
    background: $background;
}

.row {
    height: auto;
    width: 1fr;
    margin: 0;
}

/* One blank line before each question, and nowhere else. Turns need to be
 * separable at a glance; the rows inside a turn belong together and padding
 * between them only pushes the answer off the screen. */
UserRow {
    margin-top: 1;
}

/* Except the first, which would otherwise start one line down from nothing. */
#transcript > UserRow:first-of-type {
    margin-top: 0;
}

/* The rail is a gutter widget, never a character in the body: that is what
 * keeps it out of copied text and out of the session history.
 *
 * height: auto, not 1fr. A fr unit inside an auto-height row is circular —
 * Textual resolved it against the viewport instead of the sibling, so every
 * row rendered eighteen lines tall and the transcript looked like it had
 * enormous gaps between the question and the answer. */
.rail {
    width: 2;
    height: auto;
    min-height: 1;
    color: $muted;
}

.rail-voice    { color: $voice; }
.rail-evidence { color: $evidence; }
.rail-hedge    { color: $hedge; }
.rail-muted    { color: $muted; }

.body {
    width: 1fr;
    height: auto;
}

.user-body     { color: $voice; text-style: bold; }
.notice-body, .tool-body, .citation-body { text-style: none; }
.tool-body     { color: $muted; }
.notice-body   { color: $hedge; }
.citation-body { color: $evidence; }

.row.failed .rail,
.row.failed .body { color: $fault; }

/* Markdown brings its own block spacing, which stacks badly one row per
 * paragraph. The row owns the spacing instead. */
.row Markdown {
    margin: 0;
    padding: 0;
}

.row MarkdownBlock {
    margin: 0;
    padding: 0;
}

/* A fenced block is the one place prose earns a panel: it is quoted material,
 * and on a black ground it needs an edge to read as quoted. */
.row MarkdownFence {
    margin: 1 0;
    padding: 0 1;
    background: $panel;
}

/* A folded brief. Collapsible brings its own chrome; the row owns spacing. */
.brief-body {
    height: auto;
    background: $background;
    border: none;
    padding: 0;
}

.brief-body CollapsibleTitle {
    color: $muted;
    padding: 0;
}

/* -- the input ---------------------------------------------------------- */

#prompt {
    /* Round, and on the page rather than on a panel. A filled grey box reads
     * as a dialog widget; the border alone is enough to say "type here", and
     * it doubles as the focus indicator. */
    border: round $panel;
    background: $background;
    margin-top: 1;
    /* Grows with the text and stops; a prompt must never eat the transcript. */
    height: auto;
    max-height: 10;
}

#prompt:focus {
    /* One accent, and it means "you": the rail on your turns, the microphone,
     * and the ring around the thing you are typing into. */
    border: round $voice;
}

StatusBar {
    height: 1;
    background: $background;
    color: $muted;
    padding: 0 2;
}

Footer {
    background: $background;
    color: $muted;
}

FooterKey {
    background: $background;
}

FooterKey .footer-key--key {
    color: $voice;
    background: $background;
}

FooterKey .footer-key--description {
    color: $muted;
    background: $background;
}

/* Slash-command completion. Above the prompt, never over the transcript:
 * an overlay that hides what you are asking about is the wrong trade. */
#completion {
    height: auto;
    max-height: 10;
    border: none;
    padding: 0 1;
    background: $panel;
    color: $muted;
    scrollbar-size-vertical: 1;
}

#completion > .option-list--option-highlighted {
    background: $voice;
    color: $background;
    text-style: bold;
}
