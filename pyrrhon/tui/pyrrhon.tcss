/* All layout and styling for the Textual channel (D6).
 *
 * Every colour is a token from theme.py. A hex value in this file, or in any
 * widget module, is a bug: `grep -rn "#[0-9a-fA-F]\{6\}" pyrrhon/tui/` must
 * match theme.py and nothing else.
 */

Screen {
    background: $ink;
}

#transcript {
    height: 1fr;
    padding: 0 1;
    background: $ink;
}

StatusBar {
    height: 1;
    background: $panel;
    color: $muted;
    padding: 0 1;
}

#prompt {
    border: tall $panel;
    background: $panel;
}

#prompt:focus {
    /* evidence is the focus ring as well as the verified rail: one blue,
     * meaning "this is the thing you are working with". */
    border: tall $evidence;
}

#splash {
    height: auto;
    padding: 1 1 0 1;
    background: $ink;
}

/* -- the transcript and its rows ---------------------------------------- */

#transcript {
    scrollbar-size-vertical: 1;
}

.row {
    height: auto;
    width: 1fr;
    margin: 0;
}

/* The rail is a gutter widget, never a character in the body: that is what
 * keeps it out of copied text and out of the session history. */
.rail {
    width: 2;
    height: 1fr;
    color: $muted;
}

.rail-voice    { color: $voice; }
.rail-evidence { color: $evidence; }
.rail-hedge    { color: $hedge; }
.rail-muted    { color: $muted; }

.body {
    width: 1fr;
    height: auto;
}

.user-body     { color: $voice; text-style: bold; }
.tool-body     { color: $muted; }
.notice-body   { color: $hedge; }
.citation-body { color: $evidence; }

.row.failed .rail,
.row.failed .body { color: $fault; }

/* Markdown brings its own block spacing, which stacks badly one row per
 * paragraph. The row owns the spacing instead. */
.row Markdown {
    margin: 0;
    padding: 0;
}

.row MarkdownBlock {
    margin: 0;
    padding: 0;
}
